{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "schedule:weekly"],
  "updateNotScheduled": false,
  "pre-commit": {
    "description": "Opt-in manager: bumps the frozen rev of every remote hook repo in .pre-commit-config.yaml (run by prek).",
    "enabled": true
  },
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in Taskfile.yml, annotated with a renovate: comment",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s+[A-Z_]+_VERSION: \"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ]
}
