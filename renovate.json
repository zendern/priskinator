{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in Taskfile.yml, annotated with a renovate: comment",
      "managerFilePatterns": ["/^Taskfile\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s+[A-Z_]+_VERSION: \"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ]
}
